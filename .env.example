# Copy to .env and adjust. Stripe variables are added in a later phase.

NODE_ENV=development
PORT=5000

# Comma-separated list of origins allowed to call the API (no wildcards).
CLIENT_ORIGINS=http://localhost:3000

# MongoDB Atlas (or local) connection string. Never commit the real value.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=fixmate

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# The origin the browser uses. Next.js proxies /api/* to this server, so it is the frontend URL.
BETTER_AUTH_URL=http://localhost:3000

# ImgBB API key (https://api.imgbb.com) for service images and profile photos. Server-side only.
IMGBB_API_KEY=

# Optional. JWT_ISSUER defaults to BETTER_AUTH_URL.
JWT_AUDIENCE=fixmate-api

# Used only by `npm run seed` to create the admin account (password: 12+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Used only by `npm run seed`: shared password of the demo technician and customer accounts
# (8+ characters with an uppercase and a lowercase letter).
SEED_USER_PASSWORD=
